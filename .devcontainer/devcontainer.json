{
  "name": "Thekr Android Dev",
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile",
    "args": {
      "ANDROID_SDK_VERSION": "11076708",
      "KOTLIN_LSP_VERSION": "0.253.10629"
    }
  },
  "remoteUser": "root",
  "containerEnv": {
    "ANDROID_HOME": "/opt/android-sdk",
    "ANDROID_SDK_ROOT": "/opt/android-sdk",
    "KOTLIN_LSP_VERSION": "0.253.10629"
  },
  "mounts": [
    "type=volume,source=thekr-gradle-cache,target=/root/.gradle"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-gradle",
        "redhat.vscode-xml",
        "mhutchie.git-graph",
        "ms-vscode-remote.remote-containers"
      ],
      "settings": {
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-21",
            "path": "/usr/lib/jvm/msopenjdk-21-amd64"
          }
        ],
        "kotlin.compiler.jvm.target": "21",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "bash -lc \"set -e; /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager --sdk_root=/opt/android-sdk --update; code --install-extension /opt/kotlin-lsp/kotlin-${KOTLIN_LSP_VERSION}.vsix --force || true\"",
  "features": {}
}
